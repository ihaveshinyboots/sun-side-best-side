# Copy to `.env` and fill in. `.env` is git-ignored.
# Create React App only exposes vars prefixed with REACT_APP_.

# --- Option 1: use the Cloudflare Worker (required for a deployed build) ---
# Worker base URL, no trailing slash.
# Local: http://localhost:8787   Prod: https://<name>.<subdomain>.workers.dev
REACT_APP_ROUTING_API_URL=
# Must match the Worker's APP_KEY. Ships in the bundle, so not a real secret.
REACT_APP_APP_KEY=

# --- Option 2: local dev shortcut (skips the Worker) ---
# A OneMap token to call OneMap directly. Dev only: it gets baked into the
# build, so never set this for a deployed site. Tokens expire after ~3 days.
# Leave empty to use the Worker above.
REACT_APP_ONEMAP_TOKEN=

# --- Community underground data ---
# Raw GitHub URL of the tunnel dataset fetched at runtime. Leave empty to use
# the built-in default (this repo's data/underground/tunnels.json on the source
# branch). Point it at a fork/branch to test edits before merging.
REACT_APP_UNDERGROUND_URL=
