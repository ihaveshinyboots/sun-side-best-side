{
  "name": "sun-side-best-side",
  "version": "0.1.0",
  "homepage": "https://ihaveshinyboots.github.io/sun-side-best-side",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-leaflet": "^4.2.1",
    "react-modal": "^3.16.1",
    "react-scripts": "5.0.1",
    "suncalc": "^1.9.0"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "sync:tunnels": "node -e \"require('fs').copyFileSync('data/underground/tunnels.json','src/lib/sun/tunnels.fallback.json')\"",
    "prebuild": "npm run sync:tunnels",
    "build": "react-scripts build",
    "build:native": "PUBLIC_URL=./ npm run build",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.1.1"
  }
}
